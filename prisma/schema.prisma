// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") 
}

// 1. Shopify Session Storage for Offline OAuth
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
  @@map("storeping_Session")
}

// 2. Merchant Profile & Meta WhatsApp Business Account Credentials
model Merchant {
  id                     String    @id @default(uuid())
  shop                   String    @unique
  name                   String?
  email                  String?
  phone                  String?
  currency               String    @default("INR")
  timezone               String    @default("Asia/Kolkata")
  
  // WhatsApp / Meta Credentials (waAccessToken is AES-256-GCM encrypted)
  isWhatsAppConnected    Boolean   @default(false)
  metaBusinessId         String?
  wabaId                 String?
  phoneNumberId          String?
  displayPhoneNumber     String?
  waAccessToken          String?   @db.Text
  qualityRating          String?   @default("UNKNOWN") // GREEN, YELLOW, RED
  messagingLimit         String?   @default("TIER_250") // TIER_250, TIER_1K, TIER_10K, TIER_100K, UNLIMITED
  
  // Real-time Limit & Payment Alerts
  dailySentCount         Int       @default(0)
  dailyLimitResetAt      DateTime  @default(now())
  alertType              String?   // LIMIT_EXCEEDED, PAYMENT_REQUIRED, QUALITY_FLAGGED, NONE
  alertMessage           String?   @db.Text

  // Shopify App SaaS Subscription & Plan Limits
  planId                 String    @default("FREE") // FREE, GROWTH, PRO
  subscriptionStatus     String    @default("ACTIVE") // ACTIVE, PENDING, PAST_DUE, CANCELLED
  shopifySubscriptionId  String?
  billingCurrency        String    @default("INR")
  monthlyBudgetLimit     Float     @default(1000.0) // Monthly alert threshold
  currentMonthSpend      Float     @default(0.0)
  budgetAlert50Sent      Boolean   @default(false)
  budgetAlert80Sent      Boolean   @default(false)
  budgetAlert100Sent     Boolean   @default(false)
  
  // Automation Toggles (7 Core Flows)
  cartRecoveryEnabled      Boolean   @default(true)
  cartRecoveryStrategy     String    @default("DYNAMIC_ONETIME") // REMINDER_ONLY, DYNAMIC_ONETIME, FIXED_CODE
  cartStep1Enabled         Boolean   @default(true)
  cartStep2Enabled         Boolean   @default(true)
  orderConfirmEnabled      Boolean   @default(true)
  orderShippedEnabled      Boolean   @default(true)
  orderDeliveredEnabled    Boolean   @default(true)
  promotionsEnabled        Boolean   @default(true)
  reEngagementEnabled      Boolean   @default(true)
  codVerificationEnabled   Boolean   @default(true)
  supportChatEnabled       Boolean   @default(true)
  
  // Cart Recovery Delays (in minutes) & Dynamic Coupon Settings
  cartDelay1               Int       @default(30)   // 30 min (Gentle Reminder)
  cartDelay2               Int       @default(360)  // 6 hours (Discount Follow-up)
  cartDelay3               Int       @default(1440) // 24 hours
  cartDiscountPrefix       String?   @default("CART") // Custom prefix / pattern: "CART", "VIP", "SAVE"
  cartDiscountPercent      Int       @default(10)   // Discount percentage (e.g. 10%)
  cartDiscountExpiryHours  Int       @default(24)   // Coupon expiry in hours (e.g. 24 hours)
  cartDiscountCode         String?   // For FIXED_CODE model (e.g. "SAVE10")
  
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  templates              Template[]
  jobs                   Job[]
  messages               MessageLog[]
  cartRecoveries         CartRecovery[]
  conversations          Conversation[]
  orderConfirmations     OrderConfirmation[]
  users                  User[]
  invitations            TeamInvitation[]
  apiLogs                MetaApiLog[]

  @@map("storeping_Merchant")
}

// 3. Custom Visual Templates (Core Flows)
model Template {
  id             String    @id @default(uuid())
  merchantId     String
  merchant       Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  eventType      String    // ORDER_CONFIRM_ADDRESS, ORDER_CONFIRM, COD_CONFIRM, ORDER_SHIPPED, ORDER_DELIVERED, CART_RECOVERY_1, CART_RECOVERY_2, WIN_BACK, SUPPORT_AUTO_REPLY
  name           String
  category       String?   @default("UTILITY") // UTILITY, MARKETING
  language       String    @default("en")
  headerType     String?   @default("NONE") // NONE, TEXT, IMAGE
  headerText     String?
  headerMediaUrl String?
  bodyText       String    @db.Text
  footerText     String?
  buttonType     String?   @default("QUICK_REPLY") // NONE, QUICK_REPLY, CTA_URL, MULTI_BUTTON
  buttonText     String?
  buttonUrl      String?
  buttons        Json?     // Array of { id, text, type, url? } for interactive multi-button payloads
  isActive       Boolean   @default(true)
  metaTemplateId String?
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([merchantId, eventType])
  @@map("storeping_Template")
}

// 3.1 Order & Address Confirmation Lifecycle Record
model OrderConfirmation {
  id                 String    @id @default(uuid())
  merchantId         String
  merchant           Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orderId            String    // Shopify order ID or draft order ID
  orderNumber        String    // e.g. "#1002"
  customerPhone      String    // E.164 clean phone e.g. "919374626600"
  customerName       String?
  totalAmount        String?
  currency           String    @default("INR")
  shippingAddress    String?   @db.Text
  itemsSummary       String?   @db.Text
  status             String    @default("PENDING") // PENDING, CONFIRMED, UPDATE_REQUESTED, CANCELLED
  confirmedAt        DateTime?
  customerNotes      String?   @db.Text // Address or contact update notes from customer
  lastSentAt         DateTime?
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([merchantId, orderNumber])
  @@index([merchantId, status])
  @@index([merchantId, customerPhone])
  @@map("storeping_OrderConfirmation")
}

// 4. PostgreSQL-Backed Async Job Queue (Zero-Cost Redis Alternative)
model Job {
  id             String    @id @default(uuid())
  merchantId     String
  merchant       Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  jobType        String    // SEND_WHATSAPP, RECOVERY_TIMER, SYNC_STATUS, CLEANUP
  payload        Json
  status         String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED, CANCELLED
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  runAt          DateTime  @default(now())
  processedAt    DateTime?
  error          String?   @db.Text
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, runAt])
  @@index([merchantId])
  @@map("storeping_Job")
}

// 5. Abandoned Cart Tracking & Recovery Funnel
model CartRecovery {
  id             String    @id @default(uuid())
  merchantId     String
  merchant       Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  checkoutToken  String    @unique
  shopifyCartId  String?
  customerName   String?
  customerPhone  String
  cartTotal      Float
  currency       String    @default("INR")
  lineItems      Json      // Array of {title, image, price, quantity}
  checkoutUrl    String    @db.Text
  discountCode   String?
  
  status         String    @default("PENDING") // PENDING, SENT, RECOVERED, EXPIRED, CANCELLED
  sequenceStep   Int       @default(0)         // 0: none, 1: 1st sent, 2: 2nd sent, etc.
  recoveredAt    DateTime?
  orderId        String?
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([merchantId, status])
  @@map("storeping_CartRecovery")
}

// 6. Message Audit Log & Delivery Receipts
model MessageLog {
  id              String    @id @default(uuid())
  merchantId      String
  merchant        Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  recipientPhone  String    // Masked for DPDP logs
  customerName    String?
  eventType       String
  metaMessageId   String?   @unique
  status          String    @default("SENT") // SENT, DELIVERED, READ, FAILED
  errorMessage    String?
  
  // Real-time Pricing & Meta Billing Telemetry
  pricingCategory String?   @default("UTILITY") // MARKETING, UTILITY, AUTHENTICATION, SERVICE
  isBillable      Boolean   @default(true)
  estimatedCost   Float     @default(0.0)
  
  createdAt       DateTime  @default(now())

  @@index([merchantId, createdAt])
  @@index([merchantId, pricingCategory])
  @@map("storeping_MessageLog")
}

// 7. Live Customer Support & 2-Way Conversations Inbox
model Conversation {
  id                 String        @id @default(uuid())
  merchantId         String
  merchant           Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customerPhone      String
  customerName       String?
  lastOrderNumber    String?       // E.g. #1001 or #1024
  lastOrderId        String?
  lastMessageText    String?       @db.Text
  lastMessageAt      DateTime      @default(now())
  unreadCount        Int           @default(0)
  status             String        @default("ACTIVE") // ACTIVE, CLOSED, RESOLVED
  cswExpiresAt       DateTime?     // Customer service window expiration (24h)
  
  messages           ChatMessage[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@unique([merchantId, customerPhone])
  @@index([merchantId, lastMessageAt])
  @@index([merchantId, customerPhone])
  @@index([merchantId, lastOrderNumber])
  @@map("storeping_Conversation")
}

model ChatMessage {
  id                 String        @id @default(uuid())
  conversationId     String
  conversation       Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender             String        // "MERCHANT" | "CUSTOMER" | "BOT"
  messageType        String        @default("TEXT") // TEXT, TEMPLATE, INTERACTIVE, IMAGE, VIDEO, DOCUMENT, AUDIO
  bodyText           String        @db.Text
  mediaUrl           String?       @db.Text
  mediaId            String?
  mimeType           String?
  caption            String?       @db.Text
  metaMessageId      String?       @unique
  status             String        @default("SENT") // SENT, DELIVERED, READ, FAILED
  errorMessage       String?
  createdAt          DateTime      @default(now())

  @@index([conversationId, createdAt])
  @@map("storeping_ChatMessage")
}

// 8. DPDP Act 2023 Consent Audit Record
model DPDPConsent {
  id             String    @id @default(uuid())
  shop           String    @unique
  consented      Boolean   @default(true)
  consentVersion String    @default("v1.0")
  purposes       String    @db.Text // JSON list of consented purposes
  ipAddress      String?
  userAgent      String?
  consentedAt    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  withdrawnAt    DateTime?

  @@index([shop])
  @@map("storeping_DPDPConsent")
}

// 9. Application Logging & Audit Trail
model Log {
  id        String   @id @default(uuid())
  shop      String?
  level     String   @default("info") // info, warn, error, debug
  message   String
  details   String?  @db.Text
  source    String?  // auth, webhook, queue, meta, cart, dpdp
  createdAt DateTime @default(now())

  @@index([shop])
  @@index([level])
  @@index([createdAt])
  @@map("storeping_Log")
}

// 10. Organization Team Members & RBAC User Accounts
model User {
  id             String    @id @default(uuid())
  merchantId     String?
  merchant       Merchant? @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  email          String    @unique
  passwordHash   String
  name           String
  role           String    @default("AGENT") // SUPER_ADMIN, OWNER, MANAGER, AGENT
  avatarUrl      String?
  isActive       Boolean   @default(true)
  approvalStatus String    @default("APPROVED") // PENDING, APPROVED, REJECTED
  lastLoginAt    DateTime?
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([merchantId])
  @@index([email])
  @@map("storeping_User")
}

// 11. Team Invitation Token Registry
model TeamInvitation {
  id             String    @id @default(uuid())
  merchantId     String
  merchant       Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  email          String
  role           String    @default("AGENT") // MANAGER, AGENT
  token          String    @unique
  expiresAt      DateTime
  status         String    @default("PENDING") // PENDING, ACCEPTED, REVOKED
  
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([merchantId])
  @@index([token])
  @@map("storeping_TeamInvitation")
}

// 12. Meta Graph & WhatsApp Cloud API Audit Log
model MetaApiLog {
  id             String    @id @default(uuid())
  merchantId     String?
  merchant       Merchant? @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  endpoint       String    // e.g. "POST /v21.0/{phoneNumberId}/messages"
  httpMethod     String    // POST, GET, DELETE
  statusCode     Int?      // 200, 400, 401, 500, etc.
  durationMs     Int?      // Request duration in ms
  status         String    @default("SUCCESS") // SUCCESS, FAILED, RATE_LIMITED
  metaMessageId  String?   // Meta WAMID or Media ID returned
  requestPayload String?   @db.Text // Sanitized JSON payload
  responseBody   String?   @db.Text // Meta JSON response / error details
  rateLimitUsage String?   // x-business-use-case-usage or x-app-usage header
  initiatedBy    String?   // User email, "SYSTEM", "CRON_JOB", "WEBHOOK"
  ipAddress      String?
  errorMessage   String?   @db.Text
  
  createdAt      DateTime  @default(now())

  @@index([merchantId, createdAt])
  @@index([status])
  @@index([endpoint])
  @@index([createdAt])
  @@map("storeping_MetaApiLog")
}

// 13. Dynamic Platform Support & Help Settings (Configurable via Super Admin)
model PlatformSetting {
  id              String   @id @default("global")
  supportEmail    String   @default("support@everonlab.in")
  supportPhone    String   @default("+91 93746 26600")
  supportWhatsApp String   @default("919374626600")
  supportHours    String   @default("Monday - Saturday: 9:00 AM - 8:00 PM IST")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("storeping_PlatformSetting")
}
