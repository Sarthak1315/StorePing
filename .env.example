# StorePing Environment Variables Example Template

# PostgreSQL Database (Shared Myshopify Database)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Shopify App configuration
SHOPIFY_APP_URL="https://storeping.everonlab.in"
SHOPIFY_API_KEY="your_shopify_api_key_here"
SHOPIFY_API_SECRET="your_shopify_api_secret_here"
SCOPES="read_checkouts,read_customers,read_discounts,read_fulfillments,read_orders,read_products,write_checkouts,write_discounts,write_fulfillments,write_orders"

# Meta / Facebook WhatsApp Cloud API
META_APP_ID="your_meta_app_id_here"
META_APP_SECRET="your_meta_app_secret_here"
META_CONFIG_ID="your_meta_config_id_here"
META_WEBHOOK_VERIFY_TOKEN="your_meta_webhook_verify_token_here"

# Enterprise AES-256-GCM Encryption Key
ENCRYPTION_SECRET="your_32byte_secret_key_here"
CRON_SECRET="your_cron_secret_here"
PORT=3000
